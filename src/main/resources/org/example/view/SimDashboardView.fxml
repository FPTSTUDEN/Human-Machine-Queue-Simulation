<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.SimController"
            prefWidth="1200"
            prefHeight="850"
            style="-fx-background-color: #F5F5F5;">

    <!-- HEADER -->

    <top>

        <HBox alignment="CENTER"
              prefHeight="90"
              style="
                -fx-background-color: white;
                -fx-padding: 20;
                -fx-border-color: transparent transparent #DDDDDD transparent;
              ">

            <Label text="Human - Machine Queue Simulation"
                   style="
                    -fx-font-size: 26px;
                    -fx-font-weight: bold;
                    -fx-text-fill: #222222;
                   "/>

        </HBox>

    </top>


    <!-- SETTINGS -->

    <left>

        <VBox spacing="10"
              prefWidth="330"
              style="
                -fx-padding: 25;
                -fx-background-color: white;
              ">

            <Label text="Simulation Settings"
                   style="
                    -fx-font-size: 20px;
                    -fx-font-weight: bold;
                   "/>


            <Label text="Human cashiers"/>

            <TextField fx:id="humanCashierField"
                       text="2"/>


            <Label text="Self-checkouts"/>

            <TextField fx:id="selfCheckoutField"
                       text="3"/>


            <Label text="Arrival rate"/>

            <TextField fx:id="arrivalRateField"
                       text="20"/>


            <Label text="Maximum waiting time"/>

            <TextField fx:id="maximumWaitingTimeField"
                       text="5"/>


            <Label text="Simulation duration"/>

            <TextField fx:id="simulationDurationField"
                       text="480"/>


            <Button fx:id="startButton"
                    text="Start Simulation"
                    onAction="#startSimulation"
                    maxWidth="Infinity"
                    style="
                        -fx-background-color: #4CAF50;
                        -fx-text-fill: white;
                        -fx-font-size: 15px;
                        -fx-font-weight: bold;
                        -fx-padding: 12;
                        -fx-background-radius: 5;
                    "/>

        </VBox>

    </left>


    <!-- LIVE SIMULATION -->

    <center>

        <VBox spacing="15"
              style="
                -fx-padding: 25;
                -fx-background-color: #F4F4F4;
              ">

            <Label text="Live Simulation"
                   style="
                    -fx-font-size: 20px;
                    -fx-font-weight: bold;
                   "/>


            <Pane fx:id="simulationPane"
                  prefWidth="700"
                  prefHeight="380"
                  minHeight="320"
                  style="
                    -fx-background-color: white;
                    -fx-border-color: #CCCCCC;
                    -fx-border-radius: 7;
                    -fx-background-radius: 7;
                  "/>


            <HBox spacing="55"
                  alignment="CENTER">

                <!-- HUMAN -->

                <VBox spacing="8"
                      alignment="CENTER">

                    <Label text="Human Cashiers"
                           style="
                            -fx-font-weight: bold;
                            -fx-font-size: 14px;
                           "/>

                    <HBox fx:id="humanCashierContainer"
                          spacing="10"
                          alignment="CENTER"/>

                </VBox>


                <!-- MACHINE -->

                <VBox spacing="8"
                      alignment="CENTER">

                    <Label text="Self-Checkout Machines"
                           style="
                            -fx-font-weight: bold;
                            -fx-font-size: 14px;
                           "/>

                    <HBox fx:id="machineCashierContainer"
                          spacing="10"
                          alignment="CENTER"/>

                </VBox>

            </HBox>

        </VBox>

    </center>


    <!-- RESULTS -->

    <bottom>

        <VBox spacing="10"
              prefHeight="220"
              style="
                -fx-padding: 18 25 20 25;
                -fx-background-color: white;
                -fx-border-color: #DDDDDD transparent transparent transparent;
              ">

            <Label text="Simulation Results"
                   style="
                    -fx-font-size: 20px;
                    -fx-font-weight: bold;
                   "/>


            <TextArea fx:id="resultArea"
                      editable="false"
                      wrapText="true"
                      prefHeight="150"
                      promptText="Simulation results will appear here..."/>

        </VBox>

    </bottom>

</BorderPane>